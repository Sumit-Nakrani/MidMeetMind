<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Portfolio</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: #f4f4f4;
            color: #333;
        }

        header {
            background-color: #333;
            color: white;
            text-align: center;
            padding: 30px;
        }

        .container {
            width: 80%;
            margin: 30px auto;
            background-color: white;
            padding: 30px;
            text-align: center;
            border-radius: 10px;
        }

        h2 {
            color: #333;
        }

        p {
            font-size: 18px;
        }

        button {
            background-color: #333;
            color: white;
            border: none;
            padding: 12px 20px;
            cursor: pointer;
            border-radius: 5px;
        }

        button:hover {
            background-color: #555;
        }

        footer {
            text-align: center;
            background-color: #333;
            color: white;
            padding: 15px;
            margin-top: 30px;
        }
    </style>
</head>

<body>

    <header>
        <h1>My Portfolio</h1>
        <p>Frontend Developer</p>
    </header>

    <div class="container">

        <h2>About Me</h2>

        <p>
            Hello! My name is Darshan.
            I am learning HTML, CSS and JavaScript.
        </p>

        <h2>My Skills</h2>

        <p>HTML | CSS | JavaScript</p>

        <h2>My Project</h2>

        <p>Simple Personal Portfolio Website</p>

        <button onclick="showMessage()">Contact Me</button>

    </div>

    <footer>
        <p>© 2026 My Portfolio</p>
    </footer>

    <script>
        function showMessage() {
            alert("Thank you for visiting my portfolio!");
        }
    </script>

</body>
</html>
